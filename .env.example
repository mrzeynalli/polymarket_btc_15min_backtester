# Public-data-only collector. No credentials are accepted or required.
POLYMARKET_BT_CONFIG=configs/collector.yaml
POLYMARKET_BT_LOG_LEVEL=INFO
# POLYMARKET_BT_STORAGE_ROOT=/absolute/path/to/data
# POLYMARKET_BT_STATUS_FILE=/absolute/path/to/data/state/status.json
# Docker may set this to 0.0.0.0 while publishing the host port on 127.0.0.1 only.
# POLYMARKET_BT_HEALTH_BIND=0.0.0.0
